{
  "name": "do-not-feed-it",
  "version": "0.1.0",
  "description": "A communal monster-feeding arcade game for Hemi Arcade Contest 2.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:db": "node --experimental-strip-types --test tests/chain-state.test.mjs",
    "test:chain": "node --experimental-strip-types --test tests/chain-state.test.mjs tests/verifier.test.mjs tests/chain-api.test.mjs",
    "test:contract": "hardhat test nodejs --build-profile production",
    "test:contract:js": "node scripts/solc-build.mjs && hardhat test nodejs --no-compile",
    "contract:compile": "hardhat compile --build-profile production",
    "contract:build:js": "node scripts/solc-build.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:contract && npm run build"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@openzeppelin/contracts": "5.4.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "hardhat": "3.12.0",
    "miniflare": "4.20260730.0",
    "playwright": "^1.58.0",
    "react-server-dom-webpack": "19.2.8",
    "solc": "0.8.28",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "ws": "8.21.2",
    "vinext": {
      "image-size": "2.0.4"
    },
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    },
    "solc": {
      "tmp": "0.2.7"
    }
  },
  "type": "module"
}
