# Do Not Feed It — every environment variable the chain side reads.
# Copy to .env (never committed). Browser practice needs none of these.
# The Worker reads the DNFI_* and HEMI_RPC_* values from Cloudflare secrets / .dev.vars;
# Hardhat reads HEMI_RPC_URL and HEMI_DEPLOYER_PRIVATE_KEY (or its keystore).
# Never use a public/client-prefixed name for a private key.

# Hemi Mainnet JSON-RPC endpoint the Worker's indexer and the deploy script use. Never sent to browsers
# (it may be a keyed endpoint); see DNFI_PUBLIC_RPC_URL for what clients get.
HEMI_RPC_URL=
# Comma-separated extra RPC endpoints the Worker's indexer falls back to when the first one fails.
HEMI_RPC_FALLBACKS=
# The RPC endpoint `GET /api/chain/config` reports to browsers (the client's receipt watcher and
# wallet_addEthereumChain). Default: Hemi's public RPC (https://rpc.hemi.network/rpc). Public by nature.
DNFI_PUBLIC_RPC_URL=
# The game's public URL (https://…, no trailing path), read at build time. Link previews (Discord,
# X) need it to show the social card public/og.jpg. Unset for local development.
DNFI_SITE_URL=
# Path to a production Wrangler config, read at build time. Unset keeps the local placeholder
# DB binding. Copy wrangler.example.jsonc to wrangler.production.jsonc; see docs/CHAIN.md section 11.
DNFI_WRANGLER_CONFIG=
# Private key of the account that deploys FeedRegistry and pays its gas. Deploy-time only; never in the Worker.
HEMI_DEPLOYER_PRIVATE_KEY=
# Address of the verifier key (the public half of DNFI_VERIFIER_PRIVATE_KEY); the constructor and setVerifier take this.
DNFI_VERIFIER_ADDRESS=
# Private key the Worker signs VerifierAttestation with. Worker secret only; the contract rejects any other signer.
DNFI_VERIFIER_PRIVATE_KEY=
# Deployed FeedRegistry address on Hemi; the Worker is disabled until this and the verifier key are set.
DNFI_CONTRACT_ADDRESS=
# Chain id the Worker signs for and the client switches to; Hemi Mainnet is 43111.
DNFI_CHAIN_ID=
# Block FeedRegistry was deployed in. Required once the chain is on: the indexer starts here and the
# Worker reports itself disabled without it (deploy-registry prints it).
DNFI_DEPLOY_BLOCK=
# Blocks behind the head the indexer stops at (a reorg or a lagging fallback RPC cannot corrupt the board).
# Default 16; the local Hardhat e2e sets 0.
DNFI_CONFIRMATIONS=
# Epoch length in seconds, as passed to the constructor (default 86400; the contract's minimum is 3600).
DNFI_EPOCH_SECONDS=
# FeedRegistry.GENESIS, printed by the deploy script. Optional; avoids a wrong initial epoch
# until the indexer first reads the contract. Use the exact constructor/deployment values.
DNFI_GENESIS=
# Owner address for the deploy (pause, setVerifier, setGameVersion); defaults to the deployer when unset.
DNFI_OWNER=
# Optional public deployer-address assertion, checked before any transaction is sent.
DNFI_EXPECTED_DEPLOYER=
# Set to 1 for a deploy-script gas estimate without broadcast or a deployment journal.
DNFI_DEPLOY_DRY_RUN=
# Optional path to the public deployment journal (default deployments/<network>-<chainId>.json).
# An existing journal blocks another deployment; check its transaction/nonce before retrying.
DNFI_DEPLOYMENT_RECORD=
